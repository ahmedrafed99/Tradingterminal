# Auto-connect credentials (backend authenticates on startup)
TOPSTEP_USERNAME=your-email@example.com
TOPSTEP_PASSWORD=your-api-key

# Server port (default 3001)
PORT=3001

# Telegram bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ALLOWED_CHAT_ID=your-chat-id  # only this chat ID can send commands

KAGGLE_USERNAME=
KAGGLE_KEY=

# ML strategy server (mlNQStrategy)
ML_SERVICE_URL=http://127.0.0.1:17654
ML_TRADING_DIR=C:\path\to\MLTrading